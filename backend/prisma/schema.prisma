// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String?  @unique
  password_hash String?
  phone         String   @unique
  otp           String?
  otpExpiry     DateTime?
  otpAttempts   Int      @default(0)
  resetToken    String?
  resetTokenExpiry DateTime?
  address       String?
  role          Role     @default(CUSTOMER)
  // Expo push token for this device. Set the moment the app has a signed-in
  // user and notification permission — used to notify them when the admin
  // moves their order along.
  pushToken     String?
  orders        Order[]
  addresses     Address[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Address {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  label     String
  details   String
  city      String
  isDefault Boolean  @default(false)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  CUSTOMER
  STAFF
  OWNER
}

// Staff sign in with a name + 4-digit PIN, not a password — kept separate
// from User rather than overloading it with two different auth schemes.
model Staff {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  pinHash   String
  active    Boolean  @default(true)
  invitedAt DateTime @default(now())
}

// A saved roster the admin console picks from when assigning a delivery —
// deliberately just a contact record, not linked to Order by a foreign key.
// The name/phone/vehicle picked onto an Order are copied at assignment time
// (see updateOrderStatus), so editing or removing a rider here never
// changes what already shipped on a past order.
model Rider {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  vehicle   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Single-shop app — no restaurant-selection concept anywhere in the frontend.
model MenuItem {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Float
  image_url   String?
  // Nullable — not every existing item has one yet. Reports shows
  // "Uncategorized" when unset; the admin menu screen offers existing
  // categories as chips plus free text for a new one.
  category    String?
  // Hides it from the customer-facing menu without deleting order history.
  // Toggled from the admin menu screen; also what a "remove" falls back to
  // when the item has past orders (see deleteMenuItem).
  available   Boolean     @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  MOMO
  CARD
  CASH
}

enum MomoNetwork {
  MTN
  TELECEL
  AT
}

model Order {
  id            Int           @id @default(autoincrement())
  user          User          @relation(fields: [userId], references: [id])
  userId        Int
  address       Address?      @relation(fields: [addressId], references: [id])
  addressId     Int?
  landmark      String?
  phone         String
  paymentMethod PaymentMethod
  momoNetwork   MomoNetwork?
  deliveryFee   Float
  total_amount  Float
  status        OrderStatus   @default(NEW)
  // Independent of kitchen status — a MoMo/Card charge marks this true the
  // moment Paystack confirms it, regardless of whether the kitchen has
  // accepted the order yet. Cash orders stay false until paid on delivery.
  paid          Boolean       @default(false)
  riderName     String?
  riderPhone    String?
  riderVehicle  String?
  // Generated at order placement, shown only to the customer. Never expose
  // this on any admin-facing query — it's how the customer proves receipt
  // to the rider, so the admin console must not be able to see or leak it.
  deliveryCode  String?
  // Stamped by updateOrderStatus the moment status first moves to
  // PREPARING/READY, so Reports can compute a real "avg prep time"
  // (readyAt - acceptedAt) instead of a hardcoded number. Null for orders
  // that never reached that stage, or placed before this field existed.
  acceptedAt    DateTime?
  readyAt       DateTime?
  orderItems    OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id                     Int      @id @default(autoincrement())
  order                  Order    @relation(fields: [orderId], references: [id])
  orderId                Int
  menuItem               MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId             Int
  quantity               Int
  price_at_time_of_order Float
  extras                 Json?
}
